{
  "branding": {
    "gameTitle": "Who's That Character?",
    "promptText": "Type your guess in chat!",
    "noWinnerText": "No one got it!",
    "winnerTextTemplate": "{winner} got it!",
    "winnerStreakTextTemplate": "{winner} got it! It was {character}! {streak} streak!",
    "answerTextTemplate": "It was {character}!"
  },
  "channel": "your_channel_here",
  "twitch": {
    "useAuth": true,
    "username": "",
    "oauthToken": "",
    "ignoreBotAccount": true
  },
  "files": {
    "characterList": "characters.txt",
    "fallbackCharacterList": "characters.example.txt",
    "imageFolder": "images",
    "imageExtension": "png",
    "placeholderImage": "images/placeholder.png"
  },
  "round": {
    "autoStart": true,
    "roundDurationSeconds": 0,
    "revealDurationSeconds": 7,
    "betweenRoundsSeconds": 2,
    "avoidImmediateRepeats": true,
    "recentHistorySize": 10
  },
  "display": {
    "showDebugPanel": false,
    "showConnectionStatus": true,
    "transparentBackground": true,
    "maxImageHeight": "70vh",
    "maxImageWidth": "90vw",
    "imageOnly": false,
    "slideOutDirection": "none",
    "slideInDirection": "none",
    "slideDurationSeconds": 0.5
  },
  "controls": {
    "enableKeyboardControls": true
  },
  "streak": {
    "enabled": true,
    "announceThreshold": 2,
    "overlayTemplate": "{winner} x{streak}"
  }
}
