{
  // Your Twitch channel name (all lowercase)
  "channel": "your_channel_name",

  "branding": {
    // Title shown on the overlay. Set to " " to hide it entirely.
    "gameTitle": "Who's That Character?",
    // Text shown below the silhouette during an active round
    "promptText": "Type your guess in chat!",
    // Chat message when someone guesses correctly (no streak)
    // {winner} = display name, {character} = canonical character name
    "winnerText": "{winner} got it! It was {character}!",
    // Chat message when someone guesses correctly and has an active streak
    // {winner} = display name, {character} = character name, {streak} = streak count
    "winnerStreakText": "{winner} got it! It was {character}! {streak} streak!",
    // Chat message when nobody guesses in time
    // {character} = canonical character name
    "noWinnerText": "No one got it! It was {character}!"
  },

  "twitch": {
    // Set to true to use an authenticated bot account (required to send chat messages)
    "useAuth": true,
    // The Twitch username of your bot account
    "username": "your_bot_account",
    // OAuth token for the bot account — needs chat:read and chat:write scopes
    // Generate one at twitchtokengenerator.com
    "oauthToken": "oauth:your_token_here",
    // Set to false if your bot account is the same as your channel account and you want your own messages to count as guesses
    "ignoreBotAccount": true
  },

  "files": {
    // Path to your character list file
    "characterList": "characters.txt",
    // Fallback character list used if characterList is missing
    "fallbackCharacterList": "characters.example.txt",
    // Folder where character images are stored
    "imageFolder": "images",
    // File extension for character images (png, jpg, svg, etc.)
    "imageExtension": "png",
    // Image shown when a character's image file is missing
    "placeholderImage": "images/placeholder.png"
  },

  "display": {
    // Hide the "connected to #channel" indicator in the top right
    "showConnectionStatus": false,
    // Show the debug panel (useful for diagnosing connection or matching issues)
    "showDebugPanel": false,
    // Set to false to use a dark background instead of transparent (useful for testing outside OBS)
    "transparentBackground": true,
    // Hide the game title and prompt text, leaving only the character image
    "imageOnly": false,
    // Direction the image slides OUT when a round ends (none, left, right, up, down)
    "slideOutDirection": "none",
    // Direction the image slides IN when a new round starts (none, left, right, up, down)
    "slideInDirection": "none",
    // How long the slide animation takes, in seconds
    "slideDurationSeconds": 0.5,
    // How large the character image can get
    "maxImageHeight": "82vh",
    "maxImageWidth": "95vw"
  },

  "round": {
    // Automatically start the first round when the overlay loads
    "autoStart": true,
    // How many seconds before the answer is auto-revealed with no correct guess
    // Set to 0 to disable the timer (round runs until someone gets it)
    "roundDurationSeconds": 60,
    // How many seconds to show the revealed answer before moving on
    "revealDurationSeconds": 7,
    // How many seconds to wait after the reveal before starting the next round
    "betweenRoundsSeconds": 3,
    // Avoid picking a character that was shown recently
    "avoidImmediateRepeats": true,
    // How many recent picks to remember when avoiding repeats
    "recentHistorySize": 10,
    // When true, the next round won't start until OBS is streaming or recording
    // Useful for live streams — set to false when testing offline
    "pauseWhenNotLive": false,
    // How many seconds to wait after going live before the first round starts
    // Gives you time to get settled before the game begins. 0 = start immediately
    "goLiveDelaySeconds": 0
  },

  "controls": {
    // Enable keyboard shortcuts (N = next, R = reveal, D = debug, S = silhouette, P = pick, Space = reveal/next)
    "enableKeyboardControls": true
  },

  "streak": {
    // Set to false to disable streak tracking entirely
    "enabled": true,
    // How many consecutive correct answers before the streak appears in the win message
    // e.g. 2 means it shows from the second correct answer onward
    "announceThreshold": 2,
    // Text shown on the overlay while a streak is active (hidden if count < 2)
    // {winner} = display name, {streak} = count
    "overlayTemplate": "{winner} x{streak}"
  }
}
